{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-default-window-icon",
    "notification:default",
    "store:default",
    "process:allow-exit",
    { "identifier": "http:default", "allow": [{ "url": "http://127.0.0.1:*" }] },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "ssh-tunnel",
          "cmd": "ssh",
          "sidecar": false,
          "args": [
            { "validator": "^-N$" },
            { "validator": "^-L$" },
            { "validator": "^\\d{1,5}:127\\.0\\.0\\.1:\\d{1,5}$" },
            { "validator": "^-o$" },
            { "validator": "^BatchMode=yes$" },
            { "validator": "^-o$" },
            { "validator": "^ExitOnForwardFailure=yes$" },
            { "validator": "^-o$" },
            { "validator": "^ServerAliveInterval=15$" },
            { "validator": "^-o$" },
            { "validator": "^ServerAliveCountMax=3$" },
            { "validator": "^--$" },
            { "validator": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "ssh-run",
          "cmd": "ssh",
          "sidecar": false,
          "args": [
            { "validator": "^-o$" },
            { "validator": "^BatchMode=yes$" },
            { "validator": "^-o$" },
            { "validator": "^ServerAliveInterval=15$" },
            { "validator": "^-o$" },
            { "validator": "^ServerAliveCountMax=3$" },
            { "validator": "^--$" },
            { "validator": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
            { "validator": "^systemctl --user start cctower$" }
          ]
        }
      ]
    },
    "shell:allow-kill",
    "shell:allow-open"
  ]
}
